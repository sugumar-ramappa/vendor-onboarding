<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.learning</groupId>
  <artifactId>vendor-onboarding</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>vendor-onboarding</name>
  <description>Multi-agent supplier onboarding review, measured against seeded defects</description>

  <properties>
    <java.version>21</java.version>

    <!--
      Versions verified against repo1 metadata, not the Maven search API -
      the search API serves stale data and reported langchain4j 1.0.0 when
      1.19.0 was current.

      Compatibility that matters: langgraph4j-parent 1.8.24 pins
      spring-ai.version to 2.0.0, so 2.0.1 is a safe patch bump. Bumping
      Spring AI to a new MINOR would need this rechecked.
    -->
    <spring-ai.version>2.0.1</spring-ai.version>
    <langgraph4j.version>1.8.24</langgraph4j.version>
    <testcontainers.version>2.0.5</testcontainers.version>

    <!-- Defaults for the flyway-maven-plugin; override on the command line. -->
    <flyway.url>jdbc:postgresql://localhost:5432/vendor_onboarding</flyway.url>
    <flyway.user>postgres</flyway.user>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.bsc.langgraph4j</groupId>
        <artifactId>langgraph4j-bom</artifactId>
        <version>${langgraph4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Spring Boot 4's BOM does not manage org.testcontainers, so import theirs. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Gemini via Google AI Studio - the same free-tier key as the RAG project.
      The google-genai SDK also fronts Vertex AI, so moving to a GCP billing
      account later is a configuration change, not a dependency change.
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-google-genai</artifactId>
    </dependency>

    <!--
      MCP server. This is the reason the project uses Spring AI rather than
      LangChain4j: LangChain4j's MCP support is client-side only.
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
    </dependency>

    <!-- Graph orchestration: nodes, conditional edges, cycles, shared state. -->
    <dependency>
      <groupId>org.bsc.langgraph4j</groupId>
      <artifactId>langgraph4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bsc.langgraph4j</groupId>
      <artifactId>langgraph4j-spring-ai</artifactId>
    </dependency>

    <!-- Renders the compiled graph in a browser. Useful when demonstrating. -->
    <dependency>
      <groupId>org.bsc.langgraph4j</groupId>
      <artifactId>langgraph4j-studio-springboot</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Spring Data JDBC rather than JPA. The domain is immutable records, and
      JPA wants mutable entities with a no-arg constructor - fighting that would
      mean giving up the immutability the guardrails depend on. JDBC maps
      records directly and the queries stay visible.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Schema as versioned migrations, never auto-generated from entities.

      Spring Boot 4 split autoconfiguration into per-technology modules, so
      flyway-core alone is NOT enough: without spring-boot-flyway the migrations
      sit on the classpath and are silently never run. The failure mode is a
      clean startup followed by "relation does not exist" at the first query.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!--
      Excel. The SKU list arrives as a spreadsheet in practice - nobody types
      400 SKUs with GTINs and case packs into a PDF - and a spreadsheet is the
      GOOD case: already structured, so it parses straight into Sku records with
      no model involved at all.
    -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.5.1</version>
    </dependency>

    <!--
      PDF text extraction. Vendors submit certificates as scanned or generated
      PDFs, and the text has to come out before anything can be parsed from it.

      Not managed by Boot's BOM, so pinned here.
    -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Testcontainers, not H2. The SQL that ships is the SQL that gets tested -
      H2 accepts syntax Postgres rejects, and every serious bug in the previous
      project in this workspace was in the SQL or the type adaptation, which an
      in-memory substitute would have faked correctly.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Lets you apply or inspect migrations without starting the application:

            ./mvnw flyway:migrate  -Dflyway.password=...
            ./mvnw flyway:info     -Dflyway.password=...

        Useful when the schema is what you want to work on, and necessary in a
        deployment pipeline where migrations run as a separate step from the
        app - which is how you avoid several instances racing to migrate.
      -->
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <configuration>
          <url>${flyway.url}</url>
          <user>${flyway.user}</user>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
          </dependency>
          <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
          </dependency>
        </dependencies>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            PDF page rendering goes through AWT, which on macOS makes a Java
            application icon appear in the dock during the test run. Headless
            mode stops that and is what a server would run with anyway.
          -->
          <systemPropertyVariables>
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
          <environmentVariables>
            <!--
              Ryuk is Testcontainers' cleanup sidecar. It fails to start under
              Rancher Desktop, so it is disabled HERE rather than in
              ~/.testcontainers.properties - a user-level setting would disable
              it for every project on the machine, including ones that rely on
              it to reap leaked containers.

              Safe because containers are declared static @Container and
              Testcontainers removes them via a JVM shutdown hook on normal
              exit. Only a hard kill (SIGKILL) can leak one, and `docker ps`
              shows it immediately.
            -->
            <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
