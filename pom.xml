<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.learning</groupId>
  <artifactId>vendor-onboarding</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>vendor-onboarding</name>
  <description>Multi-agent supplier onboarding review, measured against seeded defects</description>

  <properties>
    <java.version>21</java.version>

    <!--
      Versions verified against repo1 metadata, not the Maven search API -
      the search API serves stale data and reported langchain4j 1.0.0 when
      1.19.0 was current.

      Compatibility that matters: langgraph4j-parent 1.8.24 pins
      spring-ai.version to 2.0.0, so 2.0.1 is a safe patch bump. Bumping
      Spring AI to a new MINOR would need this rechecked.
    -->
    <spring-ai.version>2.0.1</spring-ai.version>
    <langgraph4j.version>1.8.24</langgraph4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.bsc.langgraph4j</groupId>
        <artifactId>langgraph4j-bom</artifactId>
        <version>${langgraph4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Gemini via Google AI Studio - the same free-tier key as the RAG project.
      The google-genai SDK also fronts Vertex AI, so moving to a GCP billing
      account later is a configuration change, not a dependency change.
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-google-genai</artifactId>
    </dependency>

    <!--
      MCP server. This is the reason the project uses Spring AI rather than
      LangChain4j: LangChain4j's MCP support is client-side only.
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
    </dependency>

    <!-- Graph orchestration: nodes, conditional edges, cycles, shared state. -->
    <dependency>
      <groupId>org.bsc.langgraph4j</groupId>
      <artifactId>langgraph4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bsc.langgraph4j</groupId>
      <artifactId>langgraph4j-spring-ai</artifactId>
    </dependency>

    <!-- Renders the compiled graph in a browser. Useful when demonstrating. -->
    <dependency>
      <groupId>org.bsc.langgraph4j</groupId>
      <artifactId>langgraph4j-studio-springboot</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
